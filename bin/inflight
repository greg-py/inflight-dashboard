#!/usr/bin/env bash
# inflight — the whole stack with one command. The server IS the system now
# (policy engine included); there is no separate supervisor process.
#   up       start server (caffeinate-wrapped) + open the dashboard
#   down     stop the tracked server (releases the wake lock)
#   status   server, wake lock, engine, and active-session health
#   logs     tail the server log
set -euo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
RUN_DIR="${INFLIGHT_RUN_DIR:-$HOME/.cache/inflight-dashboard}"
PID_FILE="$RUN_DIR/server.pid"
LOG_FILE="$RUN_DIR/server.log"

env_port="$(grep -E '^PORT=' "$DIR/.env" 2>/dev/null | cut -d= -f2 | tr -d ' ' || true)"
PORT="${PORT:-${env_port:-4477}}"
URL="http://localhost:$PORT"

server_up() { curl -s --max-time 3 -o /dev/null "$URL/api/health"; }
tracked_pid() { [ -f "$PID_FILE" ] && cat "$PID_FILE" 2>/dev/null || true; }
pid_alive() { [ -n "${1:-}" ] && kill -0 "$1" 2>/dev/null; }

cmd_up() {
  mkdir -p "$RUN_DIR"
  if server_up; then
    echo "server: already running at $URL"
  else
    echo "server: starting (caffeinate-wrapped — machine stays awake while it runs)"
    nohup caffeinate -ims node "$DIR/server.js" >> "$LOG_FILE" 2>&1 &
    echo $! > "$PID_FILE"
    for _ in $(seq 1 40); do server_up && break; sleep 0.25; done
    if server_up; then echo "server: up at $URL"; else
      echo "server: FAILED to start — last log lines:"; tail -5 "$LOG_FILE"; exit 1
    fi
  fi
  open "$URL"
  echo "up."
}

cmd_down() {
  pid="$(tracked_pid)"
  if pid_alive "$pid"; then
    pkill -TERM -P "$pid" 2>/dev/null || true
    kill "$pid" 2>/dev/null || true
    echo "server: stopped (wake lock released)"
  elif server_up; then
    echo "server: running at $URL but not started by 'inflight up' — stop it where you started it"
  else
    echo "server: not running"
  fi
  rm -f "$PID_FILE"
  echo "down."
}

cmd_status() {
  if ! server_up; then echo "server:  DOWN"; return; fi
  pid="$(tracked_pid)"
  if pid_alive "$pid"; then
    echo "server:  running at $URL (pid $pid, wake lock held)"
  else
    echo "server:  running at $URL (started outside 'inflight up' — no wake lock tracked)"
  fi
  curl -s --max-time 5 "$URL/api/health" | python3 -c "
import json, sys, time
h = json.load(sys.stdin)
age = int(time.time() - h['lastPassAt'] / 1000) if h.get('lastPassAt') else None
print(f\"engine:  autopilot {'on' if h.get('autopilot') else 'OFF'}\" + (f\", last pass {age // 60}m ago\" if age is not None else \", no pass yet\"))
print(f\"sessions: {h.get('activeSessions', 0)} active\")"
}

cmd_logs() { tail -n 100 -f "$LOG_FILE"; }

case "${1:-}" in
  up) cmd_up ;;
  down) cmd_down ;;
  status) cmd_status ;;
  logs) cmd_logs ;;
  *) echo "usage: inflight up | down | status | logs"; exit 1 ;;
esac
