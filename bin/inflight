#!/usr/bin/env bash
# inflight — bring the whole dashboard stack up or down with one command.
#   up [--no-supervisor]  start server (caffeinate-wrapped) + supervisor loop + browser
#   down                  stop the tracked server (and its wake lock), close the supervisor window
#   status                server, wake lock, and supervisor-heartbeat health
#   logs                  tail the server log
set -euo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
RUN_DIR="${INFLIGHT_RUN_DIR:-$HOME/.cache/inflight-dashboard}"
PID_FILE="$RUN_DIR/server.pid"
WIN_FILE="$RUN_DIR/supervisor-window"
LOG_FILE="$RUN_DIR/server.log"

env_port="$(grep -E '^PORT=' "$DIR/.env" 2>/dev/null | cut -d= -f2 | tr -d ' ' || true)"
PORT="${PORT:-${env_port:-4477}}"
URL="http://localhost:$PORT"
SUPERVISOR_LAUNCH="claude --model opus --effort low '/loop 10m /dashboard-supervisor'"
HEARTBEAT_FRESH_SECS=900

server_up() { curl -s --max-time 3 -o /dev/null "$URL/"; }

tracked_pid() { [ -f "$PID_FILE" ] && cat "$PID_FILE" 2>/dev/null || true; }

pid_alive() { [ -n "${1:-}" ] && kill -0 "$1" 2>/dev/null; }

heartbeat_age_secs() {
  curl -s --max-time 5 "$URL/api/journal?limit=100" 2>/dev/null | python3 -c "
import json, sys, time
try:
    events = json.load(sys.stdin)['events']
    passes = [e for e in events if e.get('actor') == 'supervisor' and e.get('action') == 'supervision pass']
    print(int(time.time() - passes[0]['at'] / 1000) if passes else -1)
except Exception:
    print(-1)"
}

supervisor_window_alive() {
  [ -f "$WIN_FILE" ] || return 1
  osascript -e "tell application \"Terminal\" to exists window id $(cat "$WIN_FILE")" 2>/dev/null | grep -q true
}

cmd_up() {
  local no_supervisor=0 new_supervisor=0
  for arg in "$@"; do
    case "$arg" in
      --no-supervisor) no_supervisor=1 ;;
      --new-supervisor) new_supervisor=1 ;;
    esac
  done
  mkdir -p "$RUN_DIR"

  if server_up; then
    echo "server: already running at $URL"
  else
    echo "server: starting (caffeinate-wrapped — machine stays awake while it runs)"
    nohup caffeinate -ims node "$DIR/server.js" >> "$LOG_FILE" 2>&1 &
    echo $! > "$PID_FILE"
    for _ in $(seq 1 40); do server_up && break; sleep 0.25; done
    if server_up; then echo "server: up at $URL"; else
      echo "server: FAILED to start — last log lines:"; tail -5 "$LOG_FILE"; exit 1
    fi
  fi

  if [ "$no_supervisor" = 1 ]; then
    echo "supervisor: skipped (--no-supervisor)"
  else
    age="$(heartbeat_age_secs)"
    if [ "$new_supervisor" = 1 ] && supervisor_window_alive; then
      osascript -e "tell application \"Terminal\" to close window id $(cat "$WIN_FILE")" 2>/dev/null || true
      rm -f "$WIN_FILE"
      echo "supervisor: closed the tracked window (--new-supervisor)"
    fi
    if [ "$new_supervisor" = 0 ] && supervisor_window_alive; then
      echo "supervisor: window already open"
    elif [ "$new_supervisor" = 0 ] && [ "$age" -ge 0 ] && [ "$age" -lt "$HEARTBEAT_FRESH_SECS" ]; then
      echo "supervisor: a loop is already alive (last pass $((age / 60))m ago) — not spawning another"
      echo "            (an untracked loop? close its Terminal window, then rerun with --new-supervisor)"
    else
      echo "supervisor: opening Terminal with the loop"
      win="$(osascript \
        -e "tell application \"Terminal\" to do script \"cd $DIR && $SUPERVISOR_LAUNCH\"" \
        -e 'tell application "Terminal" to activate' | sed -E 's/.*window id ([0-9]+).*/\1/')"
      [ -n "$win" ] && echo "$win" > "$WIN_FILE"
    fi
  fi

  open "$URL"
  echo "up."
}

cmd_down() {
  pid="$(tracked_pid)"
  if pid_alive "$pid"; then
    pkill -TERM -P "$pid" 2>/dev/null || true
    kill "$pid" 2>/dev/null || true
    echo "server: stopped (wake lock released)"
  elif server_up; then
    echo "server: running at $URL but not started by 'inflight up' — stop it where you started it"
  else
    echo "server: not running"
  fi
  rm -f "$PID_FILE"

  if supervisor_window_alive; then
    osascript -e "tell application \"Terminal\" to close window id $(cat "$WIN_FILE")" 2>/dev/null || true
    echo "supervisor: window close requested (Terminal may ask to confirm)"
  else
    echo "supervisor: no tracked window"
  fi
  rm -f "$WIN_FILE"
  echo "down."
}

cmd_status() {
  if server_up; then
    pid="$(tracked_pid)"
    if pid_alive "$pid"; then
      echo "server:     running at $URL (pid $pid, wake lock held)"
    else
      echo "server:     running at $URL (started outside 'inflight up' — no wake lock tracked)"
    fi
  else
    echo "server:     DOWN"
  fi

  age="$(heartbeat_age_secs)"
  if [ "$age" -lt 0 ]; then
    echo "supervisor: no heartbeat found in the journal"
  elif [ "$age" -lt "$HEARTBEAT_FRESH_SECS" ]; then
    echo "supervisor: alive — last pass $((age / 60))m ago"
  else
    echo "supervisor: STALE — last pass $((age / 60))m ago"
  fi

  supervisor_window_alive && echo "supervisor window: open (id $(cat "$WIN_FILE"))" || true
}

cmd_logs() { tail -n 100 -f "$LOG_FILE"; }

case "${1:-}" in
  up) shift; cmd_up "$@" ;;
  down) cmd_down ;;
  status) cmd_status ;;
  logs) cmd_logs ;;
  *) echo "usage: inflight up [--no-supervisor|--new-supervisor] | down | status | logs"; exit 1 ;;
esac
