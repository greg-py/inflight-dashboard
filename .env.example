JIRA_EMAIL=you@performyard.com
JIRA_API_TOKEN=your-token-here
# JIRA_BASE_URL=https://performyard.atlassian.net
# GITHUB_TOKEN=  (optional; defaults to `gh auth token`)
# REPOS_DIR=/Users/you/Projects  (where PerformYard/Logan/QA/koala are cloned; default ~/Projects)
# PORT=4477
# AUTOPILOT=off        (engine observes only; the UI pill toggles this live)
# AUTONOMOUS=off       (build fully-gated interactive prompts instead of --autonomous)
# DIAGNOSE=off         (disable headless CI/review diagnosis runs)
# ENGINE_INTERVAL_MS=150000
