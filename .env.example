JIRA_EMAIL=you@performyard.com
JIRA_API_TOKEN=your-token-here
# JIRA_BASE_URL=https://performyard.atlassian.net
# GITHUB_TOKEN=  (optional; defaults to `gh auth token`)
# PORT=4477

# Bug goalie strip. Without these the strip says so and nothing else changes.
# SLACK_TOKEN=      user or bot token with channels:history on the goalie channel
# SLACK_USER_ID=    your Slack member ID, so the strip can say when it is you
# SLACK_GOALIE_CHANNEL=  (optional; defaults to the channel set in config.js)
